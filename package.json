{
  "name": "vaishviq-knowledge-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Persistent Vaishviq Pitra and Guru Maataa Universal Knowledge Lineage Explorer runtime.",
  "scripts": {
    "dev": "next dev apps/web",
    "dev:clean": "rm -rf apps/web/.next .next .turbo apps/web/.turbo node_modules/.cache && next dev apps/web",
    "build": "next build apps/web",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "radio:milestones": "node scripts/product-factory/complete-radio-next-milestones.mjs",
    "radio:hdfc:test": "PYTHONPATH=integrations/hdfc-upi-parser python3 -m unittest discover -s integrations/hdfc-upi-parser/tests",
    "radio:proof:milestones": "node scripts/product-factory/complete-radio-proof-milestones.mjs",
    "radio:payment:proof": "node scripts/product-factory/verify-radio-payment-proof.mjs",
    "radio:playback:gate": "node scripts/product-factory/prepare-radio-playback-gate.mjs",
    "radio:rights:packet": "node scripts/product-factory/prepare-radio-rights-closure-packet.mjs",
    "radio:rights:closure": "node scripts/product-factory/verify-radio-rights-closure.mjs",
    "radio:promote": "node scripts/promote-verified-tracks.mjs",
    "radio:rights:proof": "node scripts/prepare-radio-asset-rights-proof.mjs",
    "radio:verified:list": "node scripts/prepare-radio-track-verified-list.mjs",
    "radio:stations": "node scripts/assign-stations.mjs",
    "radio:remaining:packets": "node scripts/product-factory/prepare-radio-remaining-proof-packets.mjs",
    "radio:release:review": "node scripts/product-factory/verify-radio-release-review.mjs",
    "radio:customer:release": "node scripts/product-factory/prepare-radio-customer-release-milestone.mjs",
    "radio:release:check": "node scripts/product-factory/radio-release-evidence-orchestrator.mjs",
    "radio:storage:audit": "node scripts/media-storage-audit.mjs",
    "radio:tracks:import": "node scripts/import-radio-tracks-to-db.mjs",
    "radio:lyrics:prompter": "node scripts/build-lyrics-prompter-data.mjs",
    "radio:lyrics:sync": "node scripts/check-lyrics-prompter-sync.mjs",
    "radio:lyrics:book": "node scripts/build-lyrics-book.mjs",
    "radio:tracks:versions": "node scripts/build-unique-track-versions.mjs",
    "radio:install:channels": "node scripts/build-install-channels.mjs",
    "radio:admin:kanban": "node scripts/build-radio-admin-kanban.mjs",
    "radio:tree:detail": "node scripts/build-radio-tree-detail.mjs",
    "radio:repo:scan": "node scripts/scan-radio-related-repositories.mjs",
    "radio:suno:latest": "node scripts/build-suno-latest-list.mjs",
    "radio:engine:manifest": "node scripts/build-radio-engine-manifest.mjs",
    "radio:content": "node scripts/build-radio-content.mjs && node scripts/build-radio-engine-manifest.mjs",
    "radio:routes": "node scripts/build-route-registry.mjs",
    "radio:registry": "node --experimental-strip-types scripts/build-registry-platform.mjs",
    "radio:registry:migrate": "node scripts/generate-registry-modules.mjs",
    "radio:seed": "node scripts/seed-catalog.mjs",
    "radio:seed:dry": "node scripts/seed-catalog.mjs --dry-run",
    "radio:offline:sync": "node scripts/download-offline-assets.mjs",
    "radio:backend:start": "node apps/radio-backend/server.js",
    "radio:backend:test-streams": "ENABLE_TEST_STREAMS=1 node apps/radio-backend/server.js",
    "radio:prototype:hygiene": "node scripts/report-radio-prototype-hygiene.mjs",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/three": "^0.184.1",
    "csv-parse": "^5.5.6",
    "lucide-react": "^1.17.0",
    "next": "^16.2.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.184.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.8"
  }
}
