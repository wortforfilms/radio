generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Pitra {
  id                 String             @id @default(cuid())
  nodeId             String?            @unique
  name               String
  alternateNames     String?
  description        String?
  provenanceNote     String?
  sourceCitation     String?
  verificationStatus String @default("UNVERIFIED")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  node               KnowledgeNode?     @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([verificationStatus])
}

model GuruMaataa {
  id                 String             @id @default(cuid())
  nodeId             String?            @unique
  name               String
  alternateNames     String?
  description        String?
  provenanceNote     String?
  sourceCitation     String?
  verificationStatus String @default("UNVERIFIED")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  node               KnowledgeNode?     @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([verificationStatus])
}

model Rishi {
  id                 String             @id @default(cuid())
  nodeId             String?            @unique
  name               String
  alternateNames     String?
  gotra              String?
  periodLabel        String?
  description        String?
  provenanceNote     String?
  sourceCitation     String?
  verificationStatus String @default("UNVERIFIED")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  node               KnowledgeNode?     @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([gotra])
  @@index([verificationStatus])
}

model Rishika {
  id                 String             @id @default(cuid())
  nodeId             String?            @unique
  name               String
  alternateNames     String?
  periodLabel        String?
  description        String?
  provenanceNote     String?
  sourceCitation     String?
  verificationStatus String @default("UNVERIFIED")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  node               KnowledgeNode?     @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([verificationStatus])
}

model Civilization {
  id                 String             @id @default(cuid())
  nodeId             String?            @unique
  name               String             @unique
  parentId           String?
  description        String?
  provenanceNote     String?
  sourceCitation     String?
  verificationStatus String @default("UNVERIFIED")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  node               KnowledgeNode?     @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  parent             Civilization?      @relation("CivilizationHierarchy", fields: [parentId], references: [id])
  children           Civilization[]     @relation("CivilizationHierarchy")
  subjects           Subject[]
  texts              Text[]

  @@index([parentId])
  @@index([verificationStatus])
}

model Subject {
  id                 String             @id @default(cuid())
  nodeId             String?            @unique
  name               String             @unique
  slug               String             @unique
  parentId           String?
  civilizationId     String?
  description        String?
  provenanceNote     String?
  sourceCitation     String?
  verificationStatus String @default("UNVERIFIED")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  node               KnowledgeNode?     @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  parent             Subject?           @relation("SubjectHierarchy", fields: [parentId], references: [id])
  children           Subject[]          @relation("SubjectHierarchy")
  civilization       Civilization?      @relation(fields: [civilizationId], references: [id], onDelete: SetNull)
  texts              Text[]
  researchPapers     ResearchPaper[]
  courses            Course[]

  @@index([slug])
  @@index([parentId])
  @@index([civilizationId])
}

model Language {
  id                 String             @id @default(cuid())
  nodeId             String?            @unique
  name               String             @unique
  isoCode            String?            @unique
  script             String?
  provenanceNote     String?
  sourceCitation     String?
  verificationStatus String @default("UNVERIFIED")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  node               KnowledgeNode?     @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  texts              Text[]
  sanskritLexemes    SanskritLexeme[]

  @@index([name])
}

model SanskritLexeme {
  id                 String             @id @default(cuid())
  nodeId             String?            @unique
  headword           String
  transliteration    String?
  normalizedHeadword String
  sourceDictionary   String
  definition         String?
  partOfSpeech       String?
  languageId         String?
  provenanceNote     String?
  sourceCitation     String?
  verificationStatus String @default("UNVERIFIED")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  node               KnowledgeNode?     @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  language           Language?          @relation(fields: [languageId], references: [id], onDelete: SetNull)

  @@unique([normalizedHeadword, sourceDictionary])
  @@index([headword])
  @@index([transliteration])
  @@index([sourceDictionary])
  @@index([languageId])
  @@index([verificationStatus])
}

model Text {
  id                 String             @id @default(cuid())
  nodeId             String?            @unique
  title              String
  alternateTitles    String?
  languageId         String?
  subjectId          String?
  civilizationId     String?
  periodLabel        String?
  summary            String?
  contentMarkdown    String?
  provenanceNote     String?
  sourceCitation     String?
  verificationStatus String @default("UNVERIFIED")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  node               KnowledgeNode?     @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  language           Language?          @relation(fields: [languageId], references: [id], onDelete: SetNull)
  subject            Subject?           @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  civilization       Civilization?      @relation(fields: [civilizationId], references: [id], onDelete: SetNull)

  @@index([title])
  @@index([languageId])
  @@index([subjectId])
  @@index([civilizationId])
}

model KnowledgeNode {
  id                 String             @id @default(cuid())
  type               String
  label              String
  summary            String?
  payload            String?
  provenanceNote     String?
  sourceCitation     String?
  verificationStatus String @default("UNVERIFIED")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  outgoingEdges      KnowledgeEdge[]    @relation("EdgeFrom")
  incomingEdges      KnowledgeEdge[]    @relation("EdgeTo")
  pitra              Pitra?
  guruMaataa         GuruMaataa?
  rishi              Rishi?
  rishika            Rishika?
  civilization       Civilization?
  subject            Subject?
  language           Language?
  sanskritLexeme     SanskritLexeme?
  text               Text?
  institution        Institution?
  timelineEvent      TimelineEvent?
  location           Location?
  discovery          Discovery?
  innovation         Innovation?
  mediaAsset         MediaAsset?
  researchPaper      ResearchPaper?
  course             Course?
  lineage            Lineage?

  @@index([type])
  @@index([label])
  @@index([verificationStatus])
}

model KnowledgeEdge {
  id                 String             @id @default(cuid())
  type               String
  fromNodeId         String
  toNodeId           String
  label              String?
  confidence         Float?
  provenanceNote     String?
  sourceCitation     String?
  verificationStatus String @default("UNVERIFIED")
  createdById        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  fromNode           KnowledgeNode      @relation("EdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode             KnowledgeNode      @relation("EdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)
  createdBy          User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([type, fromNodeId, toNodeId])
  @@index([type])
  @@index([fromNodeId])
  @@index([toNodeId])
  @@index([verificationStatus])
}

model Institution {
  id                 String             @id @default(cuid())
  nodeId             String?            @unique
  name               String
  locationId         String?
  description        String?
  provenanceNote     String?
  sourceCitation     String?
  verificationStatus String @default("UNVERIFIED")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  node               KnowledgeNode?     @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  location           Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  researchPapers     ResearchPaper[]
  courses            Course[]

  @@index([name])
  @@index([locationId])
}

model TimelineEvent {
  id                 String             @id @default(cuid())
  nodeId             String?            @unique
  title              String
  startDate          DateTime?
  endDate            DateTime?
  periodLabel        String?
  locationId         String?
  description        String?
  provenanceNote     String?
  sourceCitation     String?
  verificationStatus String @default("UNVERIFIED")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  node               KnowledgeNode?     @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  location           Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([startDate])
  @@index([periodLabel])
  @@index([locationId])
}

model Location {
  id                 String             @id @default(cuid())
  nodeId             String?            @unique
  name               String
  latitude           Float?
  longitude          Float?
  parentId           String?
  provenanceNote     String?
  sourceCitation     String?
  verificationStatus String @default("UNVERIFIED")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  node               KnowledgeNode?     @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  parent             Location?          @relation("LocationHierarchy", fields: [parentId], references: [id])
  children           Location[]         @relation("LocationHierarchy")
  institutions       Institution[]
  timelineEvents     TimelineEvent[]

  @@index([name])
  @@index([parentId])
}

model Discovery {
  id                 String             @id @default(cuid())
  nodeId             String?            @unique
  name               String
  subjectId          String?
  description        String?
  provenanceNote     String?
  sourceCitation     String?
  verificationStatus String @default("UNVERIFIED")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  node               KnowledgeNode?     @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([subjectId])
}

model Innovation {
  id                 String             @id @default(cuid())
  nodeId             String?            @unique
  name               String
  subjectId          String?
  description        String?
  provenanceNote     String?
  sourceCitation     String?
  verificationStatus String @default("UNVERIFIED")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  node               KnowledgeNode?     @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([subjectId])
}

model MediaAsset {
  id                 String             @id @default(cuid())
  nodeId             String?            @unique
  title              String
  uri                String?
  mediaType          String?
  checksum           String?
  provenanceNote     String?
  sourceCitation     String?
  verificationStatus String @default("UNVERIFIED")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  node               KnowledgeNode?     @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  mediaObjects       MediaObject[]

  @@index([title])
  @@index([mediaType])
  @@index([checksum])
}

model StorageProvider {
  id                 String        @id @default(cuid())
  slug               String        @unique
  name               String
  kind               String        // "local_fs" | "s3" | "r2" | "gcs" | "azure_blob" | "ipfs"
  rootUri            String        // file:///..., s3://bucket/prefix, r2://bucket/prefix, etc.
  publicBaseUri      String?
  region             String?
  isPrimary          Boolean       @default(false)
  failClosed         Boolean       @default(true)
  provenanceNote     String?
  sourceCitation     String?
  verificationStatus String        @default("UNVERIFIED")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  mediaObjects       MediaObject[]

  @@index([kind])
  @@index([isPrimary])
  @@index([verificationStatus])
}

model MediaObject {
  id                 String                @id @default(cuid())
  providerId         String
  mediaAssetId       String?
  objectKey          String
  storageUri         String
  publicUri          String?
  mediaKind          String                // "audio" | "cover" | "video" | "image" | "model" | "document" | "waveform"
  mimeType           String?
  byteSize           Int?
  checksumSha256     String?
  durationSeconds    Int?
  rightsStatus       String                @default("UNKNOWN")
  evidenceUri        String?
  provenanceNote     String?
  sourceCitation     String?
  verificationStatus String                @default("UNVERIFIED")
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  provider           StorageProvider       @relation(fields: [providerId], references: [id], onDelete: Restrict)
  mediaAsset         MediaAsset?           @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  radioTrackLinks    RadioTrackMediaLink[]

  @@unique([providerId, objectKey])
  @@index([mediaAssetId])
  @@index([mediaKind])
  @@index([checksumSha256])
  @@index([rightsStatus])
  @@index([verificationStatus])
}

model ResearchPaper {
  id                 String             @id @default(cuid())
  nodeId             String?            @unique
  title              String
  abstract           String?
  doi                String?
  url                String?
  subjectId          String?
  institutionId      String?
  provenanceNote     String?
  sourceCitation     String?
  verificationStatus String @default("UNVERIFIED")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  node               KnowledgeNode?     @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  subject            Subject?           @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  institution        Institution?       @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  @@index([title])
  @@index([doi])
  @@index([subjectId])
}

model Course {
  id                 String             @id @default(cuid())
  nodeId             String?            @unique
  title              String
  subjectId          String?
  institutionId      String?
  syllabusMarkdown   String?
  provenanceNote     String?
  sourceCitation     String?
  verificationStatus String @default("UNVERIFIED")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  node               KnowledgeNode?     @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  subject            Subject?           @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  institution        Institution?       @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  @@index([title])
  @@index([subjectId])
}

model Lineage {
  id                 String             @id @default(cuid())
  nodeId             String?            @unique
  name               String
  rootNodeId         String?
  description        String?
  provenanceNote     String?
  sourceCitation     String?
  verificationStatus String @default("UNVERIFIED")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  node               KnowledgeNode?     @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([rootNodeId])
}

model Relationship {
  id                 String             @id @default(cuid())
  key                String           @unique
  label              String
  inverseKey         String?
  description        String?
  requiresCitation   Boolean            @default(true)
  failClosed         Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model User {
  id          String          @id @default(cuid())
  email       String?         @unique
  name        String?
  role        String          @default("curator")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  edges       KnowledgeEdge[]
  auditLogs   AuditLog[]
  purchases    Purchase[]
  entitlements Entitlement[]
  // account
  displayName       String?
  country           String?          // ISO-2, e.g. "IN"
  preferredCurrency String          @default("INR") // "INR" | "USD"
  cart              Cart?
  wallets           Wallet[]
  walletTxns        WalletTransaction[]
  settings          UserSettings?
}

model AuditLog {
  id          String      @id @default(cuid())
  action      String
  entityType  String
  entityId    String
  userId      String?
  before      String?
  after       String?
  reason      String?
  citation    String?
  createdAt   DateTime    @default(now())
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([userId])
}

// ============================================================================
// Radio Vaigyaaniq — Commerce layer (preview / pro / album / purchase records)
// Money is stored in MINOR units (INR paise, USD cents) as Int — Razorpay-style.
// Strings are used in place of enums (SQLite has no native enum support).
//   productType / scope : "track" | "album" | "all_access"
//   Purchase.status     : "created" | "paid" | "failed" | "refunded"
//   currency            : "INR" | "USD"
// Defaults: single track ₹29 / $0.99. Album price is computed cheaper-than-N
// (charged for trackCount - freeTracks singles) unless an override is set.
// ============================================================================

model Album {
  id            String       @id @default(cuid())
  slug          String       @unique
  title         String
  label         String?      // "P.H.K.D." | "Magic Mushrooms" | ...
  catalogNumber String?      // e.g. VSH-F001
  trackCount    Int          @default(0)
  freeTracks    Int          @default(2)   // album = (trackCount - freeTracks) singles
  priceInrOverride Int?      // null => computed from tracks
  priceUsdOverride Int?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  tracks        RadioTrack[]
  purchases     Purchase[]
  entitlements  Entitlement[]

  @@index([slug])
  @@index([label])
}

model RadioTrack {
  id             String       @id @default(cuid())
  sunoId         String?      @unique   // source id when from Suno; null for other sources
  sourcePlatform String       @default("Suno")
  title          String
  albumId        String?
  album          Album?       @relation(fields: [albumId], references: [id], onDelete: SetNull)
  trackNumber    Int?
  priceInr       Int          @default(2900) // ₹29.00 in paise
  priceUsd       Int          @default(99)   // $0.99 in cents
  previewSeconds Int          @default(45)
  theme          String?      // catalogue theme → maps to a station
  language       String?      // "Hindi" | "Haryanvi" | "Sanskrit" | "Braj" | "English" | ...
  styles         String?
  lyricsText     String?
  lyricsBody     String?
  lyricsPath     String?
  metadataJson   String?
  catalogSource  String?
  sourceCreatedAt DateTime?
  durationSeconds Int?
  durationLabel  String?
  sourceModel    String?
  playCount      Int?
  instrumental   Boolean?
  sourceAudioPath String?
  sourceCoverPath String?
  sourceChecksum String?
  sourceBytes    Int?
  publicPath     String?
  coverPublicPath String?
  canPlay        Boolean      @default(false)
  rightsStatus   String      @default("UNKNOWN")
  verificationState String   @default("SOURCE_CATALOG")
  published      Boolean      @default(false) // mirrors rights-verified canPlay
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  purchases      Purchase[]
  entitlements   Entitlement[]
  mediaLinks     RadioTrackMediaLink[]

  @@index([albumId])
  @@index([published])
  @@index([styles])
  @@index([sourceCreatedAt])
  @@index([canPlay])
  @@index([rightsStatus])
  @@index([verificationState])
}

model RadioTrackMediaLink {
  id            String      @id @default(cuid())
  radioTrackId  String
  mediaObjectId String
  role          String      // "audio" | "preview" | "cover" | "lyrics" | "waveform" | "stems"
  isPrimary     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  radioTrack    RadioTrack  @relation(fields: [radioTrackId], references: [id], onDelete: Cascade)
  mediaObject   MediaObject @relation(fields: [mediaObjectId], references: [id], onDelete: Cascade)

  @@unique([radioTrackId, mediaObjectId, role])
  @@index([radioTrackId])
  @@index([mediaObjectId])
  @@index([role])
  @@index([isPrimary])
}

model Purchase {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productType       String       // "track" | "album" | "all_access"
  trackId           String?
  track             RadioTrack?  @relation(fields: [trackId], references: [id], onDelete: SetNull)
  albumId           String?
  album             Album?       @relation(fields: [albumId], references: [id], onDelete: SetNull)
  amountMinor       Int          // charged amount in minor units
  currency          String       // "INR" | "USD"
  status            String       @default("created")
  provider          String       @default("razorpay")
  providerOrderId   String?
  providerPaymentId String?
  receiptId         String?      @unique
  createdAt         DateTime     @default(now())
  paidAt            DateTime?
  refundedAt        DateTime?
  entitlement       Entitlement?

  @@index([userId])
  @@index([status])
  @@index([productType])
}

model Entitlement {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope       String      // "track" | "album" | "all_access"
  trackId     String?
  track       RadioTrack? @relation(fields: [trackId], references: [id], onDelete: SetNull)
  albumId     String?
  album       Album?      @relation(fields: [albumId], references: [id], onDelete: SetNull)
  purchaseId  String?     @unique
  purchase    Purchase?   @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  active      Boolean     @default(true)
  grantedAt   DateTime    @default(now())
  revokedAt   DateTime?

  @@unique([userId, scope, trackId, albumId])
  @@index([userId])
  @@index([scope])
}

// ============================================================================
// Radio Vaigyaaniq — Account layer (cart / wallet / settings)
// Money in MINOR units. Wallet balance is per-currency (one Wallet row per
// currency per user). CartItem.productType / WalletTransaction.kind are strings.
//   CartItem.productType : "track" | "album" | "all_access"
//   WalletTransaction.kind: "topup" | "debit" | "refund" | "credit" | "adjustment"
// ============================================================================

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency  String     @default("INR")
  items     CartItem[]
  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())
}

model CartItem {
  id          String   @id @default(cuid())
  cartId      String
  cart        Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productType String   // "track" | "album" | "all_access"
  trackId     String?
  albumId     String?
  // priced at add-time for display; re-validated at checkout
  amountMinor Int
  currency    String
  addedAt     DateTime @default(now())

  @@unique([cartId, productType, trackId, albumId])
  @@index([cartId])
}

model Wallet {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency  String              // "INR" | "USD"
  balance   Int                 @default(0) // minor units; never negative
  updatedAt DateTime            @updatedAt
  createdAt DateTime            @default(now())
  txns      WalletTransaction[]

  @@unique([userId, currency])
  @@index([userId])
}

model WalletTransaction {
  id            String   @id @default(cuid())
  walletId      String
  wallet        Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          String   // "topup" | "debit" | "refund" | "credit" | "adjustment"
  amountMinor   Int      // positive credit / negative debit
  currency      String
  balanceAfter  Int
  reference     String?  // purchaseId, providerPaymentId, note
  createdAt     DateTime @default(now())

  @@index([walletId])
  @@index([userId])
  @@index([kind])
}

model UserSettings {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language          String   @default("hi")   // "hi" | "en"
  preferredCurrency String   @default("INR")
  audioQuality      String   @default("standard") // "preview" | "standard" | "high"
  autoplay          Boolean  @default(true)
  theme             String   @default("dark")  // "dark" | "light"
  emailNotifications Boolean @default(true)
  pushNotifications  Boolean @default(false)
  marketingOptIn     Boolean @default(false)
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
}

// ============================================================================
// Radio Vaigyaaniq — Stations (multi-station / multi-language broadcast layer)
// A station's tracks = RadioTrack where theme is in `themes` (CSV). Languages CSV.
// Per-language variants are expressed in data/stations.json (UI), not as rows.
// ============================================================================

model Station {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  tagline   String?
  themes    String   // CSV of catalogue themes mapped to this station
  languages String   // CSV content languages, e.g. "Sanskrit,Hindi"
  accent    String?  // hex color
  coverPath String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([active])
}
