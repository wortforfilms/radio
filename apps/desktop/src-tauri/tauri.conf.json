{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Radio Vaigyaaniq",
  "version": "0.1.0",
  "identifier": "com.vaishviq.radiovaigyaaniq.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run fe:dev",
    "beforeBuildCommand": "npm run fe:build"
  },
  "app": {
    "windows": [
      {
        "title": "Radio Vaigyaaniq",
        "width": 440,
        "height": 900,
        "minWidth": 380,
        "minHeight": 680,
        "resizable": true,
        "backgroundColor": "#05060f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; media-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; frame-src 'self'",
      "capabilities": ["default"],
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$RESOURCE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "category": "Music",
    "shortDescription": "Radio Vaigyaaniq desktop",
    "longDescription": "Radio Vaigyaaniq desktop shell — opens the Radio archive entrypoints. Draft scaffold; media library and release readiness are NOT bundled or verified."
  }
}
