PORT=4000
# Single shared database — point at the Next.js app's Prisma db for entitlements/wallets.
# (apps/radio-backend/prisma/schema.prisma stays available for isolated experiments.)
DATABASE_URL=file:../../prisma/dev.db
RADIO_ENGINE_MANIFEST=../../apps/web/public/radio-html/data/radio-engine-manifest.json
RADIO_STREAM_CANDIDATES=../../apps/web/public/radio-html/data/radio-stream-candidates.json
# The Next.js app that owns payments / rights / release logic (proxied, never duplicated).
NEXT_API_BASE=http://localhost:3000
PROXY_GET_CACHE_TTL_MS=30000
SYNC_EVENTS_FILE=./sync-events.jsonl
ENABLE_TEST_STREAMS=0
ENABLE_ADS=0
# Admin lane (fail-closed: unset = all /admin/* routes answer 503).
# MVP password auth; requireAdmin() in server.js is the seam for OAuth later.
ADMIN_PASSWORD=
ADMIN_DATA_FILE=./admin-data.json
WEATHER_API_KEY=
WEATHER_CITY=Delhi
WEATHER_UNITS=metric
# Phase-2 agent cognition (fail-closed: unset provider = rule engine only).
# Providers: openai | anthropic | openrouter | local (ollama)
AGENT_LLM_PROVIDER=
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=
AGENT_LLM_BASE_URL=
# Razorpay keys live in the Next.js app env (.env at repo root), NOT here:
# RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET / RAZORPAY_WEBHOOK_SECRET
