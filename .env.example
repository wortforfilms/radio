DATABASE_URL="file:./dev.db"

# Media storage separation.
# Keep binary media outside Git and outside SQLite/PostgreSQL. Database rows
# should store only metadata, checksums, evidence, and object/public URIs.
RADIO_MEDIA_PROVIDER="local_fs"
RADIO_MEDIA_ROOT="/Volumes/LaCie/pprm/radio-media"
RADIO_MEDIA_PUBLIC_BASE=""

# Razorpay (Phase 3 — payments). You enter these; the app never ships them.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
